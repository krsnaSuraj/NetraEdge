<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#40FFFFFF"
                android:endColor="#10FFFFFF" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#E6601820"
                android:centerColor="#E6702030"
                android:endColor="#E6601820" />
            <stroke
                android:width="1.5dp"
                android:color="#55FFFFFF" />
        </shape>
    </item>
</layer-list>
