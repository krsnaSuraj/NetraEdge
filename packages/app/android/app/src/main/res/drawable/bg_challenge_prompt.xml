<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer subtle glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#40FFFFFF"
                android:endColor="#10FFFFFF" />
        </shape>
    </item>
    <!-- Main glass surface with rounded corners -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#E61A2540"
                android:centerColor="#E61F3060"
                android:endColor="#E61A2540" />
            <stroke
                android:width="1.5dp"
                android:color="#55FFFFFF" />
        </shape>
    </item>
</layer-list>
