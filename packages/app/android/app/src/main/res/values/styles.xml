<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ====================================================== -->
    <!-- 2026 Premium Button System — Material 3 Expressive     -->
    <!-- Gradient fills, multi-layer shadows, 28dp corners     -->
    <!-- ====================================================== -->

    <style name="NetraButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/btn_surface</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:elevation">8dp</item>
        <item name="android:translationZ">4dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="NetraButton.Primary">
        <item name="android:background">@drawable/btn_primary_gradient</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="NetraButton.Success">
        <item name="android:background">@drawable/btn_success_gradient</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="NetraButton.Gold">
        <item name="android:background">@drawable/btn_gold_gradient</item>
        <item name="android:textColor">#0A0A14</item>
    </style>

    <style name="NetraButton.Outline">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/brand_text_secondary</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Signal bar (liveness layer indicator) -->
    <style name="SignalBar">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">6dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bar_neutral</item>
    </style>
</resources>
